{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huggingface.co/datasets/MANMEET75/SaptahMem-Bench/raw/main/schemas/episode.schema.json",
  "title": "SaptahMem-Bench episode",
  "description": "One fictional short-horizon conversational-memory episode with chronological messages and questions at explicit cutoffs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "split", "start_time", "duration_hours", "scenario_domain", "language", "messages", "questions"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "split": {"enum": ["dev", "pilot", "test"]},
    "start_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "duration_hours": {"const": 168},
    "scenario_domain": {"type": "string", "minLength": 2},
    "language": {"type": "string", "minLength": 2},
    "messages": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["message_id", "timestamp", "session_id", "speaker", "text"],
        "properties": {
          "message_id": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "session_id": {"type": "string"},
          "speaker": {"enum": ["user", "assistant"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_id", "query_time", "question", "primary_category", "secondary_categories", "answerability", "gold_answer", "acceptable_answers", "source_message_ids", "rubric", "difficulty"],
        "properties": {
          "question_id": {"type": "string"},
          "query_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "question": {"type": "string", "minLength": 1},
          "primary_category": {"enum": ["episodic_recall", "cross_session_binding", "temporal_recency", "state_update", "ephemeral_intent", "preference_scope", "entity_binding", "distraction_resistance", "abstention", "window_boundary"]},
          "secondary_categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "answerability": {"enum": ["answerable", "unanswerable", "ambiguous"]},
          "gold_answer": {"type": ["string", "null"]},
          "acceptable_answers": {"type": "array", "items": {"type": "string"}},
          "source_message_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "rubric": {"type": "string", "minLength": 1},
          "difficulty": {"enum": ["easy", "medium", "hard"]}
        },
        "allOf": [
          {"if": {"properties": {"answerability": {"const": "answerable"}}, "required": ["answerability"]}, "then": {"properties": {"gold_answer": {"type": "string", "minLength": 1}, "source_message_ids": {"minItems": 1}}}},
          {"if": {"properties": {"answerability": {"enum": ["unanswerable", "ambiguous"]}}, "required": ["answerability"]}, "then": {"properties": {"gold_answer": {"type": ["string", "null"]}}}}
        ]
      }
    }
  }
}
